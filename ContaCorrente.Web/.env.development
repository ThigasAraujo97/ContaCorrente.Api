# Vazio: as chamadas saem como /api/... na propria origem (localhost:5173) e o proxy
# do Vite as encaminha para VITE_API_PROXY. Em desenvolvimento nao ha CORS.
VITE_API_URL=

# Destino do proxy: a API .NET.
VITE_API_PROXY=http://localhost:5232

# false = consome a API real. true = repositorio em memoria, para ver a tela sem backend.
VITE_USE_MOCK=false
