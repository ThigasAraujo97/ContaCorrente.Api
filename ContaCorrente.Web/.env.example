# Deixe vazio para usar o proxy do Vite (/api -> VITE_API_PROXY). Em producao,
# informe a URL publica da API, ex.: https://minha-api.com
VITE_API_URL=

# Destino do proxy de desenvolvimento (perfil "http" da ContaCorrente.Api)
VITE_API_PROXY=http://localhost:5232

# true  -> usa um repositorio em memoria no navegador (demo sem backend)
# false -> consome a API .NET
VITE_USE_MOCK=false
